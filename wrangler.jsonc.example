/**
 * wrangler.jsonc の雛形。実 ID と公開ホスト名を含む wrangler.jsonc は追跡しない。
 * `npm run cf:config` で環境変数 D1_DATABASE_ID / APP_HOSTNAME を埋めて生成する。
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tabilog",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "tabilog"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tabilog-db",
			"database_id": "__D1_DATABASE_ID__",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS_BUCKET",
			"bucket_name": "tabilog-photos"
		}
	],
	"vars": {
		"AUTH_TRUST_HOST": "true"
	},
	// 公開 URL はカスタムドメインのみ。プレビュー URL は Google の許可リダイレクト URI に
	// 含められずログインできないため無効にする
	"routes": [
		{
			"pattern": "__APP_HOSTNAME__",
			"custom_domain": true
		}
	],
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Secrets（wrangler secret put で登録。値はリポジトリに含めない）:
	 *   AUTH_SECRET         セッション署名鍵（openssl rand -base64 32）
	 *   AUTH_GOOGLE_ID      Google OAuth クライアント ID
	 *   AUTH_GOOGLE_SECRET  Google OAuth クライアントシークレット
	 *   ALLOWED_EMAILS      ログインを許可するメールアドレス（カンマ区切り）
	 */
}
